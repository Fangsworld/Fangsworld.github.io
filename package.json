{
  "name": "next-temp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib db types tests",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:introspect": "drizzle-kit introspect",
    "db:check": "drizzle-kit check",
    "db:health": "npx tsx scripts/db-health.ts",
    "db:migrate-check": "npx tsx scripts/db-migrate-check.ts",
    "stats:view": "npx tsx scripts/view-stats.ts",
    "db:migrate-categories": "npx tsx scripts/migrate-categories.ts",
    "dev:offline": "DISABLE_DATABASE=true next dev",
    "build:offline": "DISABLE_DATABASE=true next build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test:auth": "node --test tests/admin-auth.test.mjs",
    "test:static": "node --test tests/static-routes.test.mjs",
    "verify": "npm run check:content && npm run test:content && npm run lint && npm run test:auth && npm run build:offline && npm run typecheck && npm run test:static",
    "check:content": "node scripts/validate-content.mjs",
    "test:content": "node --test scripts/validate-content.test.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.562.0",
    "marked": "^17.0.1",
    "next": "16.1.1",
    "next-mdx-remote": "^5.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20.19.27",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.1.2",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "typescript": "^5"
  }
}
